# --- Сервер ---
PORT=3000

# Telegram API (my.telegram.org). Если не заданы — используются публичные desktop-креды.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Соль шифрования файлов сессий (обязательно поменяй на свою длинную строку!)
SESSION_SECRET=

# Tor-прокси (socks5 на 127.0.0.1:9050) для Telegram и запросов к Google: 1 = вкл, 0 = выкл
USE_TOR=0

# --- tg_backup (bash + pyrogram) ---
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_API_ID=
TG_API_HASH=
# Каталог временных файлов бэкапа (по умолчанию ~/tg_backup)
TG_BACKUP_DIR=
# Прокси для curl-отправки (по умолчанию socks5h://127.0.0.1:9050)
TG_PROXY=
